# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel AI Gateway — powers the onboarding goal assistant (optional locally; on Vercel, OIDC is used automatically)
AI_GATEWAY_API_KEY=
# Optional override; defaults to deepseek/deepseek-v4.1-flash
GOAL_PLAN_MODEL=
