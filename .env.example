# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Vercel AI Gateway — powers the onboarding goal assistant (optional locally; on Vercel, OIDC is used automatically)
AI_GATEWAY_API_KEY=
# Optional override; defaults to deepseek/deepseek-v4.1-flash
GOAL_PLAN_MODEL=

# Google Places API (New) — optional. Lets players pick their gym from nearby gyms.
# Server-side only: never prefix with NEXT_PUBLIC_. Restrict the key to "Places API (New)".
GOOGLE_MAPS_API_KEY=
